<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Rebuild alarms after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Fire reminders at their exact time (user-grantable on Android 12+;
         the scheduler degrades to inexact alarms when not granted). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Surface due reminders when the app is in the background. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarm-style reminders may take over the screen when due. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Floating reminders over other apps (user-granted, gracefully optional). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Fingerprint / face acknowledgement. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- allowBackup=false: the app's core promise is that reminder data
         never leaves the device. Cloud/device-to-device backup would upload
         the Room database and settings to Google servers; users have the
         explicit local ZIP export instead. -->
    <application
        android:name=".AlertNotesApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.AlertNotes">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AlertNotes"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen alert window: over the lock screen, wakes the display. -->
        <activity
            android:name=".AlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.AlertNotes" />

        <receiver
            android:name=".services.ReminderAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".services.AlertActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".services.BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".services.TimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widgets.AlertNotesWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/alert_notes_widget_info" />
        </receiver>
    </application>

</manifest>
