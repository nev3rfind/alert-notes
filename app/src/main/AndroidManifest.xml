<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Rebuild alarms after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Fire reminders at their exact time (user-grantable on Android 12+;
         the scheduler degrades to inexact alarms when not granted). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Surface due reminders when the app is in the background. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarm-style reminders may take over the screen when due. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Floating reminders over other apps (user-granted, gracefully optional). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Fingerprint / face acknowledgement. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Online mode only: Firebase Auth + Firestore. Offline mode never
         opens a connection. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- allowBackup=false: reminder data leaves the device only through the
         user's explicit choices — the local ZIP export, or opt-in online
         mode. Cloud/device-to-device OS backup would upload the Room
         database and settings to Google servers without that consent. -->
    <application
        android:name=".AlertNotesApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.AlertNotes">

        <!-- The analytics SDK ships only to verify the Firebase connection.
             Collection stays off so offline mode's no-tracking promise
             holds; nothing in the app ever enables it at runtime. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />

        <!-- Hands the camera app a writable cache URI for avatar capture. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.alertnotes.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AlertNotes"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen alert window: over the lock screen, wakes the display. -->
        <activity
            android:name=".AlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.AlertNotes" />

        <receiver
            android:name=".services.ReminderAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".services.AlertActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".services.BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".services.TimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widgets.AlertNotesWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/alert_notes_widget_info" />
        </receiver>
    </application>

</manifest>
