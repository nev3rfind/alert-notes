<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Rebuild alarms after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Fire reminders at their exact time. Alarms are this app's core
         function, so on Android 13+ USE_EXACT_ALARM applies (granted
         automatically, cannot be revoked); SCHEDULE_EXACT_ALARM covers
         Android 12 where it is the only option. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Keep the CPU awake for the seconds between alarm delivery and the
         alert appearing on screen. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Surface due reminders when the app is in the background. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarm-style reminders may take over the screen when due. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Floating reminders over other apps (user-granted, gracefully optional). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Fingerprint / face acknowledgement. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Online mode only: Firebase Auth + Firestore. Offline mode never
         opens a connection. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Location-proof acknowledgements only; requested at capture time. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- allowBackup=false: reminder data leaves the device only through the
         user's explicit choices — the local ZIP export, or opt-in online
         mode. Cloud/device-to-device OS backup would upload the Room
         database and settings to Google servers without that consent. -->
    <application
        android:name=".AlertNotesApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.AlertNotes">

        <!-- Offline mode promises no network connection at all, and Firebase
             Cloud Messaging breaks that on its own: auto-init registers a
             Firebase installation and opens a connection from
             FirebaseInitProvider, before any app code runs, whichever mode the
             user picked. Auto-init is therefore off by default and switched on
             by PushTokenManager only once the user is in online mode and
             signed in. The flag the SDK sets then persists.

             (The analytics SDK is no longer a dependency, so there is nothing
             left to disable here for it.) -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <!-- Hands the camera app a writable cache URI for avatar capture. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.alertnotes.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AlertNotes"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Proof capture (camera / location) in a NORMAL-launchMode task:
             singleInstance AlertActivity cannot receive cross-task results,
             so proofs resolve through AcknowledgementSession instead. -->
        <activity
            android:name=".ProofCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true"
            android:theme="@style/Theme.AlertNotes" />

        <!-- Full-screen alert window: over the lock screen, wakes the display. -->
        <activity
            android:name=".AlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.AlertNotes" />

        <!-- FCM entry point: data-only pushes for chat, social, sharing, and
             silent sync wake-ups. Notifications the user sees are always
             built locally (channels, deep links, smart suppression). -->
        <service
            android:name=".services.AlertNotesMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".services.ReminderAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".services.AlertActionReceiver"
            android:exported="false" />

        <!-- exported="true" is REQUIRED, not optional, on the three receivers
             below: their broadcasts originate in system_server, and a
             non-exported receiver rejects any sender outside its own uid. With
             exported="false" the boot sweep never runs and alarms stay lost
             until the user next opens the app. Exporting costs nothing here —
             BOOT_COMPLETED, MY_PACKAGE_REPLACED, TIME_SET, TIMEZONE_CHANGED,
             DATE_CHANGED and APPWIDGET_UPDATE are all protected broadcasts, so
             the platform refuses to let any other app send them. -->
        <receiver
            android:name=".services.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".services.TimeChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widgets.AlertNotesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/alert_notes_widget_info" />
        </receiver>
    </application>

</manifest>
