# Release signing credentials.
#
# Copy to `keystore.properties` in the repository root and fill in. That file is
# git-ignored; this template is the only version that is ever committed.
#
# On CI, set the same values as environment variables instead — the build reads
# whichever is present, preferring the file:
#
#   ALERTNOTES_STORE_FILE       ALERTNOTES_STORE_PASSWORD
#   ALERTNOTES_KEY_ALIAS        ALERTNOTES_KEY_PASSWORD
#
# With neither present, `assembleRelease` still succeeds and produces an
# unsigned APK — useful for contributors and for verifying R8 output.
#
# Generate a keystore once, then keep it somewhere safe and backed up. Losing it
# means never being able to update the app on Google Play again:
#
#   keytool -genkeypair -v -keystore alert-notes-release.jks \
#     -keyalg RSA -keysize 4096 -validity 10000 -alias alert-notes

storeFile=alert-notes-release.jks
storePassword=
keyAlias=alert-notes
keyPassword=
